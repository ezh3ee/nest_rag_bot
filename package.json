{
  "name": "ai-rag-factory",
  "version": "0.0.1",
  "description": "Minimal RAG Telegram bot prototype: NestJS + grammY + Vercel AI SDK + Qdrant",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.60",
    "@ai-sdk/openai": "^4.0.54",
    "@langchain/core": "^1.2.9",
    "@langchain/qdrant": "^1.0.3",
    "@langchain/textsplitters": "^1.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "ai": "^7.0.88",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0",
    "jina-ai-provider": "^1.0.0",
    "langchain": "^1.5.10",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "@prisma/engines@7.10.0": true,
    "jina-ai-provider@1.0.0": true
  }
}
